      "content": {
        "title": "讓每個人用 AI 快速完成簡報",
        "subtitle": "從需求釐清、風格選擇到可離線分享的單檔 HTML",
        "keyPoints": ["先問清楚，再開始做", "同內容比較四種風格", "交付一個可轉傳檔案"],
        "components": []
      },
      "composition": { "primitive": "cover", "variant": "monument", "slots": { "title": "content.title", "subtitle": "content.subtitle" } }
    },
    {
      "id": "problem",
      "content": {
        "title": "成本不在畫投影片",
        "subtitle": "真正拖慢團隊的，是三個看不見的來回",
        "keyPoints": ["需求未收斂，就開始排版", "不同 AI 的產物，無法互相接手", "只想修改一頁，卻被迫重生整份簡報"],
        "components": []
      },
      "composition": { "primitive": "title-points", "variant": "editorial-index", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
