      "content": {
        "title": "把猜測換成證據",
        "subtitle": "每一個交付節點，都能回答「為什麼是這一版」",
        "keyPoints": ["輸入與主張保留來源", "版面選擇留下規則與差異", "瀏覽器驗證留下可重播證據"],
        "components": []
      },
      "composition": { "primitive": "split-proof", "variant": "proof-ledger", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
    },
    {
      "id": "metrics",
      "content": {
        "title": "少一點重做，多一點確定",
        "subtitle": "用可驗證的節點壓縮不必要的往返",
        "keyPoints": ["1 份｜可攜、可再編輯的 HTML 成果", "4 條｜真正不同的視覺路線", "2 種｜固定驗證尺寸 1600×900 與 1280×720"],
        "components": []
      },
      "composition": { "primitive": "metric-grid", "variant": "metric-contrast", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
