    {
      "id": "workflow",
      "content": {
        "title": "一條可預期的製作路徑",
        "subtitle": "五個 bounded steps，讓每次選擇都有清楚的前後關係",
        "keyPoints": ["讀取素材", "釐清核心問題", "確認敘事架構", "比較視覺路線", "輸出與驗收"],
        "components": []
      },
      "composition": { "primitive": "process-flow", "variant": "vertical-sequence", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
    },
    {
      "id": "portable",
      "content": {
        "title": "成果，不鎖在工具裡",
        "subtitle": "DeckSpec 與畫面一起走，下一個人拿到就能繼續",
        "keyPoints": ["離線可開啟", "自由轉傳", "相容 AI 可接手"],
        "components": [
          { "id": "portable-quote", "type": "text", "text": "簡報不是某個 AI 的截圖，而是一份可以被理解、修改與驗證的共同成果。" }
        ]
      },
      "composition": { "primitive": "component-focus", "variant": "quote-monument", "slots": { "title": "content.title", "subtitle": "content.subtitle", "component": "content.components.portable-quote" } }
    },
    {
      "id": "guardrails",
      "content": {
        "title": "自由，必須有邊界",
        "subtitle": "高密度頁也不等於把資訊塞進等寬卡片",
        "keyPoints": ["StyleSpec 統一整份 deck 的視覺世界", "CompositionSpec 只控制單頁結構，不偷渡內容", "最多 15 頁，長任務拆成可重試的小單位", "碰撞、爆版與 off-canvas 一律 fail-loud", "Owner 審美裁決與自動化驗證分開記錄"],
        "components": []
      },
      "composition": { "primitive": "title-points", "variant": "dense-ledger", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
    },
    {
      "id": "transition",
      "content": {
        "title": "從做完，到做對",
        "subtitle": "技術安全只是底線，真正的交付還需要視覺判斷",
        "keyPoints": ["靜態構圖先成立", "動畫不能救醜版面", "Golden 是證據，不是模板"],
        "components": []
      },
      "composition": { "primitive": "section-break", "variant": "quiet-transition", "slots": { "title": "content.title", "subtitle": "content.subtitle" } }
    },
    {
      "id": "evidence",
      "content": {
        "title": "品質由多層證據共同成立",
        "subtitle": "自動化負責守底線，Owner 負責最後的視覺裁決",
        "keyPoints": ["契約驗證", "雙尺寸 geometry", "Owner visual gate"],
        "components": [
          {
            "id": "quality-bars",
            "type": "chart",
            "chartType": "bar",
            "labels": ["內容契約", "幾何安全", "視覺一致"],
            "series": [{ "name": "Acceptance coverage", "values": [100, 100, 92] }]
          }
        ]
      },
      "composition": { "primitive": "component-focus", "variant": "evidence-axis", "slots": { "title": "content.title", "subtitle": "content.subtitle", "component": "content.components.quality-bars" } }
    },
    {
      "id": "decision",
      "content": {
        "title": "一套 deck，一個清楚的世界",
        "subtitle": "下一步不是再做一張漂亮海報，而是讓整份簡報維持同一種判斷",
        "keyPoints": ["共用同一套 typography hierarchy", "每頁構圖不同，但視覺人格一致", "交由 Owner montage 決定是否通過"],
        "components": []
      },
      "composition": { "primitive": "split-proof", "variant": "closing-manifesto", "slots": { "title": "content.title", "subtitle": "content.subtitle", "points": "content.keyPoints" } }
